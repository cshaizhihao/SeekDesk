// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
SEEKDESK_PRODUCT_NAME = SeekDesk Flutter
SEEKDESK_BUNDLE_IDENTIFIER = com.seekdesk.flutter-preview
PRODUCT_NAME = $(SEEKDESK_PRODUCT_NAME)
PRODUCT_MODULE_NAME = Runner

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = $(SEEKDESK_BUNDLE_IDENTIFIER)

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 SeekDesk contributors.

MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) SEEKDESK_FLUTTER
FRAMEWORK_SEARCH_PATHS = $(inherited) $(PROJECT_DIR)/Frameworks
ENABLE_APP_SANDBOX = NO
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
ARCHS = arm64
